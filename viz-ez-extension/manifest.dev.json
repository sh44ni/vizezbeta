{
  "manifest_version": 3,
  "name": "VizEz AutoFiller — DEV",
  "version": "1.2.0",
  "description": "DEV BUILD — Bridges extracted passport & work permit data from VizEz into the Royal Oman Police eVisa portal.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:*/*", "http://127.0.0.1:*/*", "*://viz-ez.com/*", "*://*.viz-ez.com/*", "*://vizez.vercel.app/*"],
      "js": ["content_vizez.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://www.rop.gov.om/*", "*://rop.gov.om/*", "file:///*", "http://localhost:*/*", "http://127.0.0.1:*/*"],
      "js": ["content_rop.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "VizEz AutoFiller (DEV)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
